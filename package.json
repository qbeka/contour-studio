{
  "name": "contour-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A local design tool for controlled contour line artwork with measured vector export.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsx scripts/build-site.ts",
    "preview": "vite preview --port 5173 --strictPort",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench:smoke": "tsx bench/run.ts --smoke",
    "bench": "tsx bench/run.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "paper": "0.17.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
